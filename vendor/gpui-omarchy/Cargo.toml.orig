[package]
name = "gpui-omarchy"
version = "0.1.1"
edition = "2024"
exclude = ["website/**", "examples/gallery-wasm/**"]
license = "MIT"
description = "A gpui-kit component library designed for the Omarchy system and its UI and UX conventions"
repository = "https://github.com/huacnlee/gpui-omarchy"

[dependencies]
gpui-kit = { version = "=0.6.0", default-features = false, features = ["assets"] }
toml = "0.8"
chrono = "0.4.45"

[dev-dependencies]
tempfile = "3"
gpui-kit = { version = "=0.6.0", default-features = false, features = ["test-support"] }

[profile.dev]
debug = "limited"

# gpui-pre-macros 0.3.1 leaves a helper ungated in release builds while its
# module is gated on debug_assertions. Enable it for the host proc-macro only.
[profile.release.package.gpui-pre-macros]
debug-assertions = true
